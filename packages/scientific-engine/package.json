{
  "name": "@ausnox/scientific-engine",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Ausnox scientific engine: Mars coordinates, HiRISE terrain grid, A* Marswalk routing, Mars24 solar time and EVA feasibility. Framework independent.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "evidence": "node scripts/run-evidence.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
